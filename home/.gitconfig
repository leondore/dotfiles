[init]
	defaultBranch = main
[user]
	email = leon.dore@gmail.com
	name = Leon Dore
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[color]
	ui = auto
[alias]
	co = checkout
[delta]
	navigate = true
	syntax-theme = Dracula
	dark = true
	line-numbers = true
# Machine-specific overrides (not tracked), e.g. a work email on work VMs
[include]
	path = ~/.gitconfig.local
